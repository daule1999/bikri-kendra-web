{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ── Shared by every environment (inherited) ─────────────────────────────
  "name": "bikri-kendra-local",          // only used by `wrangler dev` / `npm run preview`
  "compatibility_date": "2026-11-01",
  "main": "worker/index.ts",             // the single shared /api proxy
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // /api/* = proxy; the rest = [id] pages served from their placeholder build (worker/dynamic-routes.ts)
    "run_worker_first": ["/api/*", "/shops/*", "/inventory/movements/*", "/billing/invoices/*"]
  },
  "workers_dev": false,

  // BACKEND_URL is never committed: local = .dev.vars, deployed = Cloudflare secret.
  "vars": { "APP_ENV": "local" },

  // ── Per-environment (routes and vars are NOT inherited) ─────────────────
  // Deploy with: scripts/deploy.sh <qa|production> [tag]
  "env": {
    "production": {
      "name": "bikri-kendra",            // keeps the Worker that's live today
      // Domain is not committed: scripts/deploy.sh passes --domain from .deploy.env / CI secret.
      // BACKEND_URL is a Cloudflare *secret*, not committed here:
      //   scripts/set-backend-url.sh production <url>
      "vars": { "APP_ENV": "production" }
    },
    "qa": {
      "name": "bikri-kendra-qa",
      // Domain is not committed: scripts/deploy.sh passes --domain from .deploy.env / CI secret.
      // BACKEND_URL is a Cloudflare *secret*: scripts/set-backend-url.sh qa <url>
      "vars": { "APP_ENV": "qa" }
    }
  }
}
