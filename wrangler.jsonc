{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ── Shared by every environment (inherited) ─────────────────────────────
  "name": "bikri-kendra-local",          // only used by `wrangler dev` / `npm run preview`
  "compatibility_date": "2026-11-01",
  "main": "worker/index.ts",             // the single shared /api proxy
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // /api/* = proxy; the rest = [id] pages served from their placeholder build (worker/dynamic-routes.ts)
    "run_worker_first": ["/api/*", "/shops/*", "/inventory/movements/*", "/billing/invoices/*"]
  },
  "workers_dev": false,

  // Local preview reads BACKEND_URL from .dev.vars (see .dev.vars.example).
  "vars": { "APP_ENV": "local" },

  // ── Per-environment (routes and vars are NOT inherited) ─────────────────
  // Deploy with: scripts/deploy.sh <qa|production> [tag]
  "env": {
    "production": {
      "name": "bikri-kendra",            // keeps the Worker that's live today
      "routes": [{ "pattern": "pos.bikri-kendra.org", "custom_domain": true }],
      "vars": {
        "APP_ENV": "production",
        // Named Cloudflare Tunnel → Traefik :8091 on the backend host.
        "BACKEND_URL": "https://api.bikri-kendra.org"
      }
    },
    "qa": {
      "name": "bikri-kendra-qa",
      "routes": [{ "pattern": "qa-pos.bikri-kendra.org", "custom_domain": true }],
      "vars": {
        "APP_ENV": "qa",
        // Public HTTPS origin of the QA backend gateway.
        "BACKEND_URL": ""
      }
    }
  }
}
