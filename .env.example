# Copy to .env.production and .env.qa (gitignored). scripts/deploy.sh loads the one matching the target.
# NEXT_PUBLIC_* values are baked into the browser bundle — don't treat them as secret.

# Encrypt every /api request+response body. prod: true, qa: false
NEXT_PUBLIC_ENCRYPT_API=false
# Shared passphrase (must equal the Worker secret API_ENCRYPTION_KEY). Only used when encryption is on.
NEXT_PUBLIC_API_ENCRYPTION_KEY=
# Allow console.log/debug/info in the browser. prod: false, qa: true
NEXT_PUBLIC_ENABLE_LOGS=true
